# Variables de entorno de la app EPA (copiar como .env)
# - En Podman: las usa docker-compose/podman-compose (ver codigo/podman-compose.yml)
# - En Dokploy: se definen en el panel al crear la base de datos PostgreSQL
PORT=3000
APP_ENV=production
DATABASE_URL=postgresql://epa:CAMBIA_ESTA_CLAVE@db-epa:5432/epa
